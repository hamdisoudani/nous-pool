# nous-pool configuration
#
# Copy this file to `.env` and fill in real values. All vars use the
# NOUS_POOL_ prefix.

# ===== Server =====
NOUS_POOL_HOST=0.0.0.0
NOUS_POOL_PORT=7890
NOUS_POOL_DATA_DIR=./data
NOUS_POOL_COOKIE_SECURE=false          # set true behind HTTPS
NOUS_POOL_LOG_LEVEL=INFO

# ===== Google OAuth (REQUIRED for login) =====
# Get these from https://console.cloud.google.com/apis/credentials
# Add the redirect URI {NOUS_POOL_PUBLIC_BASE_URL}/admin/auth/google/callback
NOUS_POOL_GOOGLE_CLIENT_ID=
NOUS_POOL_GOOGLE_CLIENT_SECRET=

# Public URL where users reach this server (no trailing slash)
# Example: https://pool.example.com  or  http://localhost:7890
NOUS_POOL_PUBLIC_BASE_URL=

# Comma-separated Gmail addresses that get the admin role on first login.
# First admin is whoever signs in here first.
NOUS_POOL_ADMIN_EMAILS=

# ===== CORS (optional, comma-separated) =====
# Leave empty for same-origin-only (default — SPA is served by the same server).
NOUS_POOL_CORS_ORIGINS=